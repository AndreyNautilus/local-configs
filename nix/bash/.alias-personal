# tools
alias la='ls -lah --color=yes'
alias diff='diff --color'
if command -v bat > /dev/null; then
    # replacement for `cat`: https://github.com/sharkdp/bat
    alias ccat='bat --style=numbers --pager=never'
fi

# git
alias gss='git status -s'
alias gl='git log --oneline'
alias gd='git diff'
alias gdh='git diff HEAD'
alias gp='git pull'
alias gb='git branch'
alias gsm='git switch master && git pull'
