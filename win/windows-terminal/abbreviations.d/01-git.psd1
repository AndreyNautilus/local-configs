# Mostly reflect what I have for fish abbreviations (simplified).
@{
    gd  = 'git diff'
    gdh = 'git diff HEAD'

    gs  = 'git switch'
    gb  = 'git branch'
    gss = 'git status -s'
    gp  = 'git pull'

    gpo = 'git push origin'

    gl  = 'git log --oneline -10'

    gsm = 'git switch main && git pull'

    gf  = 'git commit --fixup'

    gra = 'git rebase --autosquash -i'

    grpo = 'git remote prune origin'
}
